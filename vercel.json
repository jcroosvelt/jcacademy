{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>(?!www$)[a-z0-9-]+)\\.jcacademy\\.online"
        }
      ],
      "destination": "/boutique.html?sub=:sub"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?!(www\\.)?jcacademy\\.online$)(?!.*\\.vercel\\.app$)(?!localhost)(?<domain>.+)"
        }
      ],
      "destination": "/boutique.html?domain=:domain"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://tzgwhhxxozujxnjjpucg.supabase.co/functions/v1/sitemap"
    },
    {
      "source": "/c/:slug",
      "destination": "https://tzgwhhxxozujxnjjpucg.supabase.co/functions/v1/share?type=course&slug=:slug"
    },
    {
      "source": "/p/:slug",
      "destination": "https://tzgwhhxxozujxnjjpucg.supabase.co/functions/v1/share?type=product&slug=:slug"
    },
    {
      "source": "/a/:slug",
      "destination": "https://tzgwhhxxozujxnjjpucg.supabase.co/functions/v1/share?type=article&slug=:slug"
    },
    {
      "source": "/n/:slug",
      "destination": "https://tzgwhhxxozujxnjjpucg.supabase.co/functions/v1/share?type=actualite&slug=:slug"
    },
    {
      "source": "/f/:slug",
      "destination": "https://tzgwhhxxozujxnjjpucg.supabase.co/functions/v1/share?type=formateur&slug=:slug"
    },
    {
      "source": "/form/:slug",
      "destination": "/formulaire.html?f=:slug"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
